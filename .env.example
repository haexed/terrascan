DATABASE_URL=postgresql://username:password@host:port/database  # required
FLASK_SECRET_KEY=your_secret_key_here  # required, any random string
FLASK_ENV=development
PORT=5000
NASA_FIRMS_API_KEY=  # https://firms.modaps.eosdis.nasa.gov/api/
WORLD_AQI_API_KEY=  # AQICN, primary air quality (https://aqicn.org/api/)
OPENAQ_API_KEY=  # air quality fallback (https://openaq.org/)
UCDP_API_TOKEN=  # conflict data (https://ucdp.uu.se/apidocs/)
OPENWEATHER_API_KEY=  # https://openweathermap.org/api
TEST_BASE_URL=http://localhost:5000  # optional, used by test_endpoints.py
